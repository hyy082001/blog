{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/article/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/article/detail/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/article/create/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/ai/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/ai/chat/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": true
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/settings/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/settings/password/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/articles/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/auth/login/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/auth/register/index",
      "style": {
        "navigationStyle": "custom"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "MY BLOG",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F4F7FB"
  }
}
